# Example environment configuration for Ludus + LUX (Architecture A).
# Copy to `.env` alongside `docker-compose.yml` or `sophon-compose.yml` (`chmod 0600 .env`).

# --- Sophon / Domain & Registry ---
SOPHON_DOMAIN=lab.example.com
INFRAVM_IP=10.0.20.11
IMAGE_TAG=latest
LUX_HOSTNAME=ludus
LUDUS_API_HOSTNAME=ludus-api

# --- Outer Proxmox VE Hypervisor (pve-prod-02) ---
LUDUS_PROXMOX_URL=https://10.0.20.12:8006
LUDUS_PROXMOX_NODE=pve-prod-02
LUDUS_PROXMOX_HOSTNAME=pve-prod-02
LUDUS_PROXMOX_INTERFACE=vmbr0
LUDUS_PROXMOX_LOCAL_IP=10.0.20.12
LUDUS_PROXMOX_PUBLIC_IP=10.0.20.12
LUDUS_PROXMOX_GATEWAY=10.0.20.1
LUDUS_PROXMOX_NETMASK=255.255.255.0
LUDUS_PROXMOX_VM_STORAGE_POOL=local-lvm
LUDUS_PROXMOX_VM_STORAGE_FORMAT=raw
LUDUS_PROXMOX_ISO_STORAGE_POOL=local
LUDUS_PROXMOX_INVALID_CERT=true

# Generated once on Proxmox via `docker/proxmox-bootstrap-token.sh`
LUDUS_PROXMOX_API_TOKEN_ID=ludus-svc@pve!controller
LUDUS_PROXMOX_API_TOKEN_SECRET=CHANGE_ME_UUID_FROM_PROXMOX_BOOTSTRAP

# 32+ char secret used for AES-256-GCM encryption at rest in Ludus (`openssl rand -base64 32`)
LUDUS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# 32+ char secret used for LUX session + SQLite settings encryption (`openssl rand -hex 32`)
LUX_APP_SECRET=CHANGE_ME_64_HEX_CHAR_RANDOM_SECRET

# --- Stateless Alpine `ludus-edge` VM on pve-prod-02 ---
LUDUS_EDGE_VM_ID=999
LUDUS_EDGE_VM_NAME=ludus-edge
LUDUS_EDGE_VM_IP=10.0.20.123
LUDUS_EDGE_VM_CIDR=10.0.20.123/24
LUDUS_EDGE_VM_GATEWAY=10.0.20.1
LUDUS_EDGE_VM_DNS=1.1.1.1
LUDUS_EDGE_PUBLIC_ENDPOINT=10.0.20.123

# --- Local Emergency Admin Fallback Account ---
LUDUS_ADMIN_USER_ID=CA
LUDUS_ADMIN_NAME=Ludus Admin
LUDUS_ADMIN_EMAIL=admin@lab.example.com
LUDUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_LOCAL_ADMIN_PASSWORD
LUDUS_LOCAL_AUTH_ENABLED=true
LUX_LOCAL_AUTH_ENABLED=true

# --- Keycloak OIDC SSO ---
KEYCLOAK_HOSTNAME=auth
KEYCLOAK_REALM=sophon
LUDUS_OIDC_ENABLED=true
LUDUS_OIDC_CLIENT_ID=ludus-api
LUDUS_OIDC_CLIENT_SECRET=CHANGE_ME_LUDUS_OIDC_CLIENT_SECRET
LUDUS_OIDC_DISPLAY_NAME=Sophon SSO
LUDUS_OIDC_ADMIN_GROUPS=ludus-admins
LUDUS_OIDC_USER_GROUPS=ludus-users
LUDUS_SSO_REQUIRE_EXISTING_USER=false

LUX_OIDC_CLIENT_ID=lux
LUX_OIDC_CLIENT_SECRET=CHANGE_ME_LUX_OIDC_CLIENT_SECRET
LUX_OIDC_DISPLAY_NAME=Sophon SSO
