---
proxmox_node: ludus               # The hostname and proxmox node name that the install will set for this machine
proxmox_interface: ens18          # The network interface that will get the static ip proxmox_local_ip
proxmox_local_ip: "192.168.0.0"   # The static IP for this machine. In some cloud providers (AWS, Azure) this will be a private IP
proxmox_public_ip: "192.168.0.0"  # The IP users will connect to via WireGuard to reach this machine
proxmox_gateway: "192.168.0.0"    # The default gateway for this machine
proxmox_netmask: "255.255.255.0"  # The netmask for this machine's network
proxmox_storage: local            # The storage pool to use for templates and VMs (default: local; if you set up ZFS manually after install, change this)
sso_require_existing_user: true   # Require an existing Ludus account with the same email for SSO; false allows automatic account creation
create_default_range: true        # Create a default range for each new user, including SSO users
# boot_disk: /dev/sda             # Optional: override the auto-detected boot disk used for grub-pc recovery (e.g. /dev/nvme0n1 on EC2/NVMe hosts)
# register_default_source: true   # Optional: set false to skip auto-registering the Bad Sector Labs source on startup
# sync_sources_on_startup: true   # Optional: set false to skip re-syncing registered sources on each startup

# --- Remote Proxmox VM Mode (run Ludus inside a non-nested Debian 12/13 VM targeting an outer Proxmox VE 8/9 host/cluster) ---
# remote_proxmox: true
# proxmox_url: "https://10.0.20.12:8006"
# proxmox_node: "pve-prod-02"                        # Target outer Proxmox node name
# proxmox_pin_to_node: true                          # Optional: pin all range VMs to proxmox_node even on multi-node SDN clusters
# proxmox_allowed_nodes: ["pve-prod-02"]             # Optional: restrict cluster placement/validation to an explicit subset of nodes
# proxmox_hostname: "10.0.20.12"                     # Optional: auto-derived from proxmox_url host if omitted
# proxmox_invalid_cert: true                         # Skip TLS verify for self-signed Proxmox certs (or set proxmox_tls_verify: true for CA certs)
# proxmox_realm: "pve"                               # Uses Proxmox built-in @pve realm (zero Linux PAM accounts on hypervisor)
# proxmox_admin_user: "root@pam"                     # Or dedicated @pve admin user with Administrator on /
# proxmox_admin_password_file: "/etc/ludus/proxmox-admin-pass" # chmod 0600 root:root secret file inside this VM
# sdn_zone: "ludus"                                  # Auto-creates 'simple' zone on 1-node Proxmox; uses 'vxlan'/'evpn' on clusters
# ludus_nat_interface: "ludusnat"                    # Proxmox SDN NAT VNet + local bridge inside Ludus VM
# ludus_nat_guest_interface: "ens19"                 # Optional: guest NIC attached to Proxmox 'ludusnat' VNet (auto-detected if omitted)
# proxmox_vm_storage_pool: "local-zfs"               # Outer Proxmox VM/template datastore
# proxmox_vm_storage_format: "raw"                   # "raw" for ZFS/LVM-thin/Ceph, "qcow2" for dir/NFS
# proxmox_iso_storage_pool: "local"                  # Outer Proxmox ISO datastore

# --- Container Architecture Mode (rootless Podman/Docker + Proxmox service token + ludus-edge VM) ---
# container_mode: true
# tls_enabled: false                                 # Set false when TLS is terminated upstream (e.g. Traefik)
# database_encryption_key_file: "/run/secrets/ludus_db_encryption_key"
# proxmox_auth_mode: "service_token"                 # Least-privilege shared PVEAPIToken (zero Proxmox passwords or @pve user creation)
# proxmox_api_token_id: "ludus-svc@pve!controller"
# proxmox_api_token_file: "/run/secrets/ludus_proxmox_api_token"
# edge_auto_provision: true                          # Automatically deploy/reconcile Alpine ludus-edge VM via Proxmox :8006
# edge_vmid: 121
# edge_vm_name: "ludus-edge"
# edge_vm_ip: "10.0.20.181"
# edge_vm_cidr_prefix: 24
# edge_vm_gateway: "10.0.20.1"
# edge_vm_bridge: "vmbr0"
# edge_allowed_client_cidrs: ["10.0.20.0/24", "100.64.0.0/10"]
# edge_proxy_enabled: true                           # Route range SSH/WinRM, Packer HTTP, and router control via ludus-edge mTLS proxy
# edge_proxy_addr: "10.0.20.181:8444"
# oidc_enabled: true                                 # Optional declarative OIDC SSO (e.g. Keycloak)
# oidc_display_name: "Keycloak"
# oidc_issuer_url: "https://auth.example.com/realms/main"
# oidc_client_id: "ludus"
# oidc_client_secret_file: "/run/secrets/ludus_oidc_client_secret"
# oidc_allowed_groups: ["ludus-users", "ludus-admins"]
# oidc_admin_groups: ["ludus-admins"]